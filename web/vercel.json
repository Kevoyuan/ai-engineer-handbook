{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/preview-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!diagrams/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/diagrams/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-2bHRpy6NCJnBMLP1uWLpzCNclUMg79W5Fzj8fNLlOAI=' 'sha256-bX2i6BvxNb/VoCdPtOvbbEFQpfdmvWPUI+/tZTeCUbU=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/chapters/01-model-api-context-foundations:ext(\\.html)?",
      "destination": "/#read/01-model-api-context-foundations",
      "permanent": false
    },
    {
      "source": "/chapters/02-enterprise-retrieval:ext(\\.html)?",
      "destination": "/#read/02-enterprise-retrieval",
      "permanent": false
    },
    {
      "source": "/chapters/03-hybrid-retrieval-query-routing:ext(\\.html)?",
      "destination": "/#read/03-hybrid-retrieval-query-routing",
      "permanent": false
    },
    {
      "source": "/chapters/04-rag-reliability-selective-answering:ext(\\.html)?",
      "destination": "/#read/04-rag-reliability-selective-answering",
      "permanent": false
    },
    {
      "source": "/chapters/05-document-pdf-rag:ext(\\.html)?",
      "destination": "/#read/05-document-pdf-rag",
      "permanent": false
    },
    {
      "source": "/chapters/06-skills-routing:ext(\\.html)?",
      "destination": "/#read/06-skills-routing",
      "permanent": false
    },
    {
      "source": "/chapters/07-memory-context-engineering:ext(\\.html)?",
      "destination": "/#read/07-memory-context-engineering",
      "permanent": false
    },
    {
      "source": "/chapters/08-agent-orchestration:ext(\\.html)?",
      "destination": "/#read/08-agent-orchestration",
      "permanent": false
    },
    {
      "source": "/chapters/09-reliability-evaluation-observability:ext(\\.html)?",
      "destination": "/#read/09-reliability-evaluation-observability",
      "permanent": false
    },
    {
      "source": "/chapters/10-serving-deployment-ai-platform:ext(\\.html)?",
      "destination": "/#read/10-serving-deployment-ai-platform",
      "permanent": false
    },
    {
      "source": "/chapters/00-ai-engineer-system-framework:ext(\\.html)?",
      "destination": "/#map",
      "permanent": false
    },
    {
      "source": "/search/:path*",
      "destination": "/#home",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "design/decision-traces-ch03-04-08-20261009": false
    }
  }
}
